{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "NexRoute",
  "version": "0.1.0",
  "identifier": "app.nexroute.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "NexRoute",
        "width": 1240,
        "height": 800,
        "minWidth": 980,
        "minHeight": 640,
        "center": true,
        "theme": "Dark",
        "backgroundColor": "#0D0D0D",
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost http://127.0.0.1:1420 ws://127.0.0.1:1420; img-src 'self' data:; font-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "DeveloperTool",
    "shortDescription": "Local proxy gateway with real-delay testing",
    "longDescription": "NexRoute imports proxy configurations, measures real HTTP latency through each one, and exposes an explicit localhost-only rotating proxy pool.",
    "externalBin": ["binaries/sing-box", "binaries/xray"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "10.15"
    },
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": ["English"]
      }
    }
  }
}
